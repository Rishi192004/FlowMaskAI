# ============================================================
# FlowMind — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=flowmind
POSTGRES_PASSWORD=flowmind_secret
POSTGRES_DB=flowmind_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://flowmind:flowmind_secret@postgres:5432/flowmind_db

# --- FastAPI / Security ---
SECRET_KEY=change_me_to_a_long_random_string_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Local Ollama assistant ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
